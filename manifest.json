{
  "manifest_version": 3,
  "name": "YouTube Ad Speedup",
  "version": "0.1.0",
  "description": "Speeds up YouTube ads and clicks visible Skip Ad controls.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
